# ============================================================================
#  TIBID Community — environment variables
#  Copy to .env.local for local development. In production set these in
#  Vercel → Project → Settings → Environment Variables.
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Database (Neon Postgres)
# ---------------------------------------------------------------------------
# In Vercel: Storage → Create Database → Neon → Connect. This is injected
# automatically, you do not need to paste it there.
# Locally: copy the pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# REQUIRED — Session signing secret
# ---------------------------------------------------------------------------
# Generate one with:  openssl rand -base64 32
# Must be at least 32 characters. Changing it signs everyone out.
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------------------
# REQUIRED — Who gets admin rights
# ---------------------------------------------------------------------------
# Comma-separated. Anyone signing up with one of these emails becomes an admin
# automatically. Set this BEFORE creating your account.
ADMIN_EMAILS="you@example.com"

# ---------------------------------------------------------------------------
# RECOMMENDED — Public site URL (used for metadata and social share cards)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://tibid.vercel.app"

# ---------------------------------------------------------------------------
# OPTIONAL — Google Sheets sync
# ---------------------------------------------------------------------------
# Without these the site works normally; registrations just aren't mirrored to
# your sheet. See README → "Google Sheets sync" for the 5-minute setup.
#
# GOOGLE_PRIVATE_KEY: paste the whole private_key value from the service-account
# JSON file, keeping the \n escapes, wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB="Registrations"

# ---------------------------------------------------------------------------
# OPTIONAL — Photo uploads for the Moments gallery (Vercel Blob)
# ---------------------------------------------------------------------------
# In Vercel: Storage → Create Database → Blob → connect to this project. The
# token is injected automatically; you do not paste it there. Without it the
# gallery still works by pasting image URLs.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# OPTIONAL — Social links
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TIKTOK_URL=""

# ---------------------------------------------------------------------------
# OPTIONAL — Google Maps Embed API key
# ---------------------------------------------------------------------------
# Without a key the site falls back to the free keyless map embed, which works
# fine. With a key you get the nicer official embed with a proper pin.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""

# ---------------------------------------------------------------------------
# OPTIONAL — Used only by `npm run db:seed`
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@tibid.community"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
